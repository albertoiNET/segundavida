      "parameters": {
        "jsCode": "const webhook = $('Webhook').first()?.json ?? {};\nlet body = webhook.body ?? webhook;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch { return [{ json: { ok: false, valid: false, error: 'invalid_json', http_status: 400 } }]; } }\nconst itemId = typeof body.item_id === 'string' ? body.item_id.trim() : '';\nconst action = typeof body.action === 'string' ? body.action.trim() : '';\nconst itemIdPattern = /^[A-Za-z0-9][A-Za-z0-9_-]{5,79}$/;\nconst actions = new Set(['interest', 'contact_attempt']);\nif (!itemIdPattern.test(itemId)) return [{ json: { ok: false, valid: false, error: 'item_id_invalid', http_status: 400 } }];\nif (!actions.has(action)) return [{ json: { ok: false, valid: false, error: 'action_invalid', http_status: 400 } }];\nconst found = $input.all().map(({ json }) => ({ json, fields: json.fields ?? json })).find(({ fields }) => String(fields.public_id ?? fields['item-id'] ?? '') === itemId);\nif (!found) return [{ json: { ok: false, valid: false, error: 'item_not_found', http_status: 404 } }];\nconst fields = found.fields;\nconst status = String(fields.status ?? 'hidden').toLowerCase();\nif (!['available', 'reserved', 'completed', 'expired'].includes(status)) return [{ json: { ok: false, valid: false, error: 'item_not_found', http_status: 404 } }];\nconst rowId = fields.Id ?? found.json.Id ?? found.json.id ?? null;\nif (rowId === null || rowId === undefined || rowId === '') return [{ json: { ok: false, valid: false, error: 'nocodb_row_id_missing', http_status: 500 } }];\nconst interestCount = Math.max(0, Number(fields.interest_count ?? 0));\nconst contactAttemptCount = Math.max(0, Number(fields.contact_attempt_count ?? 0));\nconst nextInterestCount = action === 'interest' ? interestCount + 1 : interestCount;\nconst nextContactAttemptCount = action === 'contact_attempt' ? contactAttemptCount + 1 : contactAttemptCount;\nconst count = action === 'interest' ? nextInterestCount : nextContactAttemptCount;\nreturn [{ json: { ok: true, valid: true, Id: rowId, item_id: itemId, action, count, interest_count: nextInterestCount, contact_attempt_count: nextContactAttemptCount, http_status: 200 } }];"
      },
