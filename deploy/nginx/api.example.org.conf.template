# Template only. Replace api.example.org and __ITEM_WEBHOOK_UUID__ before use.
# Do not commit the rendered server-specific file.
server {
    listen 80;
    listen [::]:80;
    server_name api.example.org;

    access_log /var/log/nginx/api.example.org.access.log;
    error_log /var/log/nginx/api.example.org.error.log warn;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.org;

    access_log /var/log/nginx/api.example.org.access.log;
    error_log /var/log/nginx/api.example.org.error.log warn;

    ssl_certificate /etc/letsencrypt/live/api.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.org/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/api.example.org/chain.pem;

    include global/security.conf;

    client_max_body_size 50m;
    limit_req_status 429;

    location = /health {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"status":"ok","service":"api.example.org"}\n';
    }

    location = /segundavida/data {
        if ($segundavida_data_args_allowed = 0) {
            return 400 '{"ok":false,"error":"invalid_query"}\n';
        }

        proxy_pass http://127.0.0.1:5678/webhook/segundavida/data;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /segundavida;
        include /etc/nginx/snippets/segundavida-cors.conf;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        limit_req zone=segundavida_api_read burst=10 nodelay;
        proxy_cache my_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_key "$scheme$request_method$host$uri|scope=$segundavida_scope_key|owner=$arg_owner_username";
        proxy_cache_valid 200 10s;
        proxy_cache_valid 404 5s;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_bypass $http_authorization $http_cookie $http_cache_control;
        proxy_no_cache $http_authorization $http_cookie $http_cache_control $upstream_http_set_cookie;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Replace __ITEM_WEBHOOK_UUID__ with the internal webhook UUID on the server.
    location ~ "^/segundavida/item/([A-Za-z0-9][A-Za-z0-9_-]{5,79})/?$" {
        if ($args != "") {
            return 400 '{"ok":false,"error":"invalid_query"}\n';
        }

        proxy_pass http://127.0.0.1:5678/webhook/__ITEM_WEBHOOK_UUID__/segundavida/item/$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /segundavida;
        include /etc/nginx/snippets/segundavida-cors.conf;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        limit_req zone=segundavida_api_read burst=10 nodelay;
        proxy_cache my_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_key "$scheme$request_method$host$uri";
        proxy_cache_valid 200 15s;
        proxy_cache_valid 404 5s;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_bypass $http_authorization $http_cookie $http_cache_control;
        proxy_no_cache $http_authorization $http_cookie $http_cache_control $upstream_http_set_cookie;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location ~ ^/segundavida/item/ {
        limit_req zone=segundavida_api_read burst=10 nodelay;
        default_type application/json;
        return 400 '{"ok":false,"error":"invalid_item_id"}\n';
    }

    # All write/auth/report endpoints are passed through and never cached.
    location /segundavida/ {
        proxy_pass http://127.0.0.1:5678/webhook/segundavida/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /segundavida;
        include /etc/nginx/snippets/segundavida-cors.conf;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        limit_req zone=segundavida_api_write burst=5 nodelay;
        proxy_cache off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
    }

    location / {
        return 404;
    }
}
